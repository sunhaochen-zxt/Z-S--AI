{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist-electron",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts"]
}
